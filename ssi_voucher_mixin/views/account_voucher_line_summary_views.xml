<odoo>
<record id="account_voucher_line_summary_view_tree" model="ir.ui.view">
    <field name="name">account.voucher.line.summary.tree</field>
    <field name="model">account.voucher.line.summary</field>
    <field name="arch" type="xml">
        <tree>
            <field name="partner_id"/>
            <field name="account_id"/>
            <field name="amount_before_tax"/>
            <field name="amount_tax"/>
            <field name="amount_after_tax"/>
        </tree>
    </field>
</record>
<record id="account_voucher_line_summary_view_form" model="ir.ui.view">
    <field name="name">account.voucher.line.summary.form</field>
    <field name="model">account.voucher.line.summary</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group col="4">
                    <field name="partner_id"/>
                    <field name="account_id"/>
                    <field name="amount_before_tax"/>
                    <field name="amount_tax"/>
                    <field name="amount_after_tax"/>
                </group>
            </sheet>
        </form>
    </field>
</record>
</odoo>
